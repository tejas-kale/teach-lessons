filters:
  and:
    - type == "unit"
properties:
  course:
    displayName: Course
  status:
    displayName: Status
  order:
    displayName: "#"
  estimate_minutes:
    displayName: Minutes
  next_action:
    displayName: Next action
  evidence:
    displayName: Evidence
  completed_on:
    displayName: Completed
views:
  - type: table
    name: Now
    filters:
      and:
        - status == "in-progress"
    order:
      - status
      - course
      - order
  - type: table
    name: Course work
    filters:
      and:
        - status == "not-started" || status == "in-progress"
    groupBy:
      property: course
      direction: ASC
    order:
      - order
  - type: table
    name: Completed evidence
    filters:
      and:
        - status == "complete"
    order:
      - completed_on
